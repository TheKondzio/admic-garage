# Skopiuj do .env.local, jeśli chcesz nadpisać domyślny endpoint Formspree
# bez zmiany kodu (np. przy podmianie na inny formularz Formspree).
# Domyślnie (bez tego pliku) używany jest endpoint wpisany na stałe
# w src/app/api/contact/route.ts.

FORMSPREE_ENDPOINT=https://formspree.io/f/mwlewpdw

# ============================================================================
# PANEL ADMINISTRACYJNY (/admin) — wymagane, żeby panel działał.
# Bez tych dwóch wartości strona publiczna nadal działa normalnie (realizacje
# po prostu wyświetlą się jako puste, dopóki nie skonfigurujesz Supabase) —
# ale panel /admin nie zadziała.
# Skąd je wziąć i jak ustawić na Vercelu: patrz README_PANEL.md, krok 5.
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-public-key

# ============================================================================
# WIDGET OPINII GOOGLE W HERO — opcjonalne. Bez tych dwóch wartości widget
# po prostu się nie pokazuje (nie ma żadnego wpływu na resztę strony).
# CELOWO bez prefiksu NEXT_PUBLIC_ — klucz API ma zostać wyłącznie po
# stronie serwera, nigdy w przeglądarce. Skąd je wziąć: patrz raport
# w rozmowie / komentarz w src/lib/googlePlaces.ts.
# ============================================================================
GOOGLE_PLACES_API_KEY=twoj-klucz-api-tylko-serwerowy
GOOGLE_PLACE_ID=ChIJ...

